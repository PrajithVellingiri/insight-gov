# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/insightgov

# JWT configuration
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Storage (Mount to persistent volume or cloud disk in production)
UPLOAD_DIR=./uploads

# AI Service base URL (internal, never exposed to frontend)
AI_SERVICE_URL=http://localhost:8001

# ---------------------------------------------------------------
# Hosted LLM Configuration (Petition Triage & Chat)
# ---------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=

# ---------------------------------------------------------------
# Hosted Embedding Configuration (RAG & Vector Search)
# ---------------------------------------------------------------
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_gemini_or_openai_api_key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BASE_URL=

# RAG Knowledge Retrieval Parameters
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.55
RAG_MAX_CONTEXT_CHARS=3500
# Vector store directory (mount to persistent disk or re-run ingest on container start)
CHROMA_FAQ_PATH=./chroma_faq_db

# ---------------------------------------------------------------
# Citizen Chatbot & Vision AI (Gemini)
# ---------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
CHAT_PROVIDER=gemini
CHAT_MODEL=gemini-3.1-flash-lite
VISION_AI_PROVIDER=gemini
VISION_AI_MODEL=gemini-3.5-flash-lite

# Optional Legacy / Offline Dev Fallback
OLLAMA_BASE_URL=http://localhost:11434

# Chatbot Session Settings
CHAT_MAX_TOKENS=800
CHAT_TEMPERATURE=0.7
CHAT_CONTEXT_WINDOW=10
CHAT_RATE_LIMIT_ANON=20
CHAT_RATE_LIMIT_USER=100
CHAT_SESSION_TTL_HOURS=24
CHAT_STREAM_TIMEOUT=60
CHAT_COMPRESSION_THRESHOLD=20