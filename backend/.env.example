# PostgreSQL connection string
# Local:   postgresql://postgres:password@localhost:5432/insightgov
DATABASE_URL=postgresql://postgres:password@localhost:5432/insightgov

# JWT configuration
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Service base URL (internal, never exposed to frontend)
AI_SERVICE_URL=http://localhost:8001
OLLAMA_BASE_URL=http://localhost:11434

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# File Storage
UPLOAD_DIR=./uploads

# Chatbot & Vision (Gemini API)
GEMINI_API_KEY=your_google_ai_studio_key
CHAT_PROVIDER=gemini
CHAT_MODEL=gemini-3.1-flash-lite
VISION_AI_PROVIDER=gemini
VISION_AI_MODEL=gemini-3.5-flash-lite