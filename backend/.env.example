# ===============================================================
# DATABASE VARIABLES
# ===============================================================
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ===============================================================
# AUTHENTICATION & SECURITY VARIABLES
# ===============================================================
SECRET_KEY=generate_64_character_hex_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===============================================================
# SERVER & NETWORK VARIABLES
# ===============================================================
PYTHON_VERSION=3.11.9
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ===============================================================
# CORS & FRONTEND ORIGINS
# ===============================================================
FRONTEND_URL=https://insightgov.vercel.app
ALLOWED_ORIGINS=https://insightgov.vercel.app,http://localhost:5173

# ===============================================================
# OBJECT STORAGE VARIABLES (local | s3 | supabase)
# ===============================================================
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
STORAGE_BUCKET=petition-images
STORAGE_URL=
STORAGE_API_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto

# ===============================================================
# AI MICROSERVICE CONNECTION (internal URL)
# ===============================================================
AI_SERVICE_URL=http://localhost:8001

# ---------------------------------------------------------------
# Hosted LLM Configuration (Petition Triage & Chat)
# ---------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=

# ---------------------------------------------------------------
# Hosted Embedding Configuration (RAG & Vector Search)
# ---------------------------------------------------------------
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_gemini_or_openai_api_key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BASE_URL=

# RAG Knowledge Retrieval Parameters
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.55
RAG_MAX_CONTEXT_CHARS=3500
# Vector store directory (mount to persistent disk or re-run ingest on container start)
CHROMA_FAQ_PATH=./chroma_faq_db

# ---------------------------------------------------------------
# Citizen Chatbot & Vision AI (Gemini)
# ---------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
CHAT_PROVIDER=gemini
CHAT_MODEL=gemini-3.1-flash-lite
VISION_AI_PROVIDER=gemini
VISION_AI_MODEL=gemini-3.5-flash-lite

# Optional Legacy / Offline Dev Fallback
OLLAMA_BASE_URL=http://localhost:11434

# Chatbot Session Settings
CHAT_MAX_TOKENS=800
CHAT_TEMPERATURE=0.7
CHAT_CONTEXT_WINDOW=10
CHAT_RATE_LIMIT_ANON=20
CHAT_RATE_LIMIT_USER=100
CHAT_SESSION_TTL_HOURS=24
CHAT_STREAM_TIMEOUT=60
CHAT_COMPRESSION_THRESHOLD=20