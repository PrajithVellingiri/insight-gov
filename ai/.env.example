# InsightGov AI Service – Environment Variables
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------
# Hosted LLM Configuration
# ---------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key
LLM_MODEL=gemini-3.1-flash-lite
LLM_BASE_URL=

# ---------------------------------------------------------------
# Hosted Embedding Configuration
# ---------------------------------------------------------------
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=your_gemini_or_openai_api_key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BASE_URL=

# Optional Offline Dev Fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Database (must match backend DATABASE_URL — used to dynamically load department mandates)
DATABASE_URL=postgresql://postgres:password@localhost:5432/insightgov

# ChromaDB Storage (Mount to persistent volume or cloud disk in production)
CHROMA_PERSIST_DIR=./chroma_data

# Duplicate detection
# Cosine similarity threshold (0.0 – 1.0). Petitions above this score are flagged as duplicates.
DUPLICATE_THRESHOLD=0.85

# AI Service Server Binding
AI_HOST=0.0.0.0
AI_PORT=8001
